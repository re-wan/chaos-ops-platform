#!/bin/sh
# ChaosOps Server 启动包装器（V2 目录结构）
# 由构建脚本生成，INSTALL_DIR 按实际安装目录替换。
INSTALL_DIR="/opt/chaosops"
cd "${INSTALL_DIR}/server" || exit 1
export ENV_FILE="${INSTALL_DIR}/data/.env"
export DATA_DIR="${INSTALL_DIR}/data"
export CHAOSOPS_LOCK_DIR="${INSTALL_DIR}/data/locks"
exec "${INSTALL_DIR}/server/.venv/bin/python3" -m uvicorn app.main:app --host 0.0.0.0 --port 8000
