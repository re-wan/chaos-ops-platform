# ChaosOps Server 环境变量模板
# 安装脚本会自动生成随机 SECRET_KEY，请勿在生产环境使用默认值。

# 应用基础配置
APP_NAME=ChaosOps
APP_VERSION=0.1.0
DEBUG=false

# 数据库配置（默认 SQLite 开箱即用，无外部依赖；多实例/高并发部署可切换 PostgreSQL）
# 注意 sqlite:/// + 绝对路径 = 开头四个斜杠。切换 PG 需先自建库并授权，
# 安装脚本会在建管理员前做连通性预检（连不上即中断并给出指引）。
DATABASE_URL=sqlite:////opt/chaosops/server/chaosops.db
# PostgreSQL 示例：
# DATABASE_URL=postgresql://chaosops:change-me@localhost/chaosops
# PG 连接池：总连接数 ≈ workers × (pool_size + max_overflow)，按并发与 PG max_connections 调整；
# SQLite 后端不使用池参数（单写者，调大收益有限）。
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=3600

# 安全密钥（必须修改，安装脚本会自动生成）
SECRET_KEY=change-me-in-production-please

# 对外访问地址（用于生成 Agent 安装命令、更新包下载链接等）。
# 必须使用 https://，指向前置 TLS 反代地址（见 docs/deployment/TLS_REVERSE_PROXY.md）。
PUBLIC_SERVER_URL=https://chaosops.example.com

# 默认管理员账号（首次安装后建议立即修改密码）
# DEFAULT_ADMIN_PASSWORD 不设置时，init_admin.py 会在首次创建账号时随机生成一次性初始口令
# 并仅打印一次到 stdout（systemd 部署可通过 journalctl -u chaosops-server 查看）；
# 显式设置时请勿使用弱口令（弱口令会在启动时记强警告）。
DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=

# Agent 认证与接入
INSTALL_KEY_TTL_SECONDS=3600
AGENT_HEARTBEAT_INTERVAL=10

# Server 自身韧性配置
LOG_DIR=/opt/chaosops/server/logs
BACKUP_DIR=/opt/chaosops/server/backups
LOCAL_AGENT_ENABLED=true
LOCAL_AGENT_CHECK_INTERVAL=10
LOCAL_AGENT_HEALTH_TIMEOUT=5.0

# Cookie 安全设置：两种部署形态二选一
# - TLS 反代部署（生产推荐）：COOKIE_SECURE=true，Secure Cookie 仅经 HTTPS 传输；
# - 纯 HTTP 内网/试用部署：COOKIE_SECURE=false，否则浏览器拒存 Secure Cookie，
#   表现为“登录成功但立即被踢”。安装脚本会按部署形态引导生成。
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# 文档开关（生产默认关闭 /docs 与 /openapi.json，开发设为 true）
DOCS_ENABLED=false

# 开放 API（Phase 3 Step 04）
# 总开关：设为 false 后 /api/open/v1/* 路由不注册（404）。
OPEN_API_ENABLED=true
# 按 License edition 的默认限流（次/分钟），JSON；Key 自带 rate_limit>0 时以 Key 为准。
OPEN_API_DEFAULT_RATE_LIMITS={"free":60,"professional":600,"enterprise":6000}
OPEN_API_RATE_LIMIT_WINDOW_SECONDS=60
# 开放 API 指标查询单次最大时间窗（天）。
OPEN_API_METRIC_MAX_RANGE_DAYS=7
# 出站 Webhook：失败最大重试次数与指数退避基数（秒）。
WEBHOOK_RETRY_MAX=5
WEBHOOK_BACKOFF_BASE_SECONDS=2
WEBHOOK_HTTP_TIMEOUT_SECONDS=10.0
# 出站 Webhook 投递并发上限与等待队列上限（告警风暴背压，队满丢弃新投递并告警）。
WEBHOOK_MAX_CONCURRENT=100
WEBHOOK_QUEUE_MAX=1000
# 出站 URL SSRF 防护：默认拦截环回/私网/链路本地（含云元数据 169.254.169.254）地址。
# 仅在回调全部位于内网的私有化部署中可设为 true；公网/混合部署严禁开启。
OUTBOUND_ALLOW_PRIVATE_HOSTS=false

# License 配置
LICENSE_FILE_PATH=/opt/chaosops/server/license.json
# SERVER_INSTALL_ID_SALT 必须由安装脚本随机生成（如 openssl rand -hex 16）。
# 切勿使用固定串，否则任何拿到源码的人都能离线定向伪造绑定本机的 License。
SERVER_INSTALL_ID_SALT=replace-with-random-hex-generated-by-installer

# 指标存储后端（influxdb / sqlite）。默认 sqlite 开箱即用、无外部依赖；
# 高吞吐场景切换为 influxdb 前请确保已正确初始化并设置真实 INFLUXDB_TOKEN。
METRIC_BACKEND_TYPE=sqlite

# InfluxDB 配置（仅绑定回环地址 127.0.0.1，不暴露到公网）
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=change-influxdb-token-in-production
INFLUXDB_ORG=chaosops
INFLUXDB_BUCKET=chaosops
INFLUXDB_RETENTION_DAYS=30

# 告警检测引擎
ALERT_DETECTOR_ENABLED=true

# Redis 任务队列（Phase 3 Step 05 性能优化）
# 不配置 REDIS_URL 时任务队列自动降级为进程内同步处理，Server 不依赖 Redis 也能启动。
# 100+ 节点 / 多 worker 部署时建议配置 Redis，开启指标/检测/通知异步化与分布式限流。
# REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# auto=配置了 REDIS_URL 且可达才启用；on=强制启用；off=强制禁用（同步降级）。
TASK_QUEUE_ENABLED=auto
TASK_QUEUE_MAX_ATTEMPTS=5
TASK_QUEUE_BACKOFF_BASE_SECONDS=1.0
TASK_QUEUE_WORKER_CONCURRENCY=2

# 自愈 5 分钟去重（设计 §4.3）：auto=Redis 可用时启用分布式去重；on/off=强制。
HEAL_DEDUP_WINDOW_SECONDS=300
HEAL_DEDUP_ENABLED=auto

# 慢查询日志：超过阈值（毫秒）记录 warning。
SLOW_QUERY_LOG_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=200

# 系统邮件（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDR=
