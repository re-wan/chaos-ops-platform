[Unit]
Description=ChaosOps Independent Watchdog
After=network.target chaosops-server.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=chaosops
Group=chaosops
WorkingDirectory=/opt/chaosops/server
Environment=CHAOSOPS_WATCHDOG_ENABLED=true
Environment=CHAOSOPS_WATCHDOG_HEALTH_URL=http://localhost:8000/health
Environment=CHAOSOPS_WATCHDOG_CHECK_INTERVAL_SECONDS=5
Environment=CHAOSOPS_WATCHDOG_FAILURE_THRESHOLD=3
Environment=CHAOSOPS_WATCHDOG_HEALTH_TIMEOUT_SECONDS=3
Environment=CHAOSOPS_WATCHDOG_RESTART_COMMAND=systemctl restart chaosops-server
Environment=CHAOSOPS_WATCHDOG_MAX_BACKOFF_SECONDS=300
ExecStart=/opt/chaosops/server/.venv/bin/python /opt/chaosops/server/watchdog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
